{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "localDB": "Server=(LocalDB)\\MSSQLLocalDB;Integrated Security=true;AttachDbFileName=D:\\Projects\\prjMeetingRoomBooking\\demo.mdf"
  },
  "Exceptionless": {
    "ServerUrl": "http://exceptionless-t.evertrust.com.tw",
    "ApiKey": ""
  },
  "ResponseWrapperSettings": {
    "Domain": "prjMeetingRoomBooking.API",
    "DefaultVersion": "1.0.0",
    "StatusTextCase": 0,
    "ExceptionSettings": {
      "ErrorWrapType": 1,
      "OutputDisplayDetails": true,
      "ExcludeData": [ "account", "password", "Password", "Pwd", "pwd" ]
    }
  },

  "Evertrust.Core.Logging.Setting": {
    "LogFilters": [
      {
        "CategoryName": "BookingController-GetByIdAsync",
        "MinLevel": "info",
        "MaxLevel": "Fatal",
        "Enable": "true"
      },
      {
        "CategoryName": "BookingController-SearchAsync",
        "Enable": "true"
      }
    ]
  }
}
